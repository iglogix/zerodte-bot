# 0DTE Iron Condor Trading Bot — Environment Variables
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.

# ============================================================
# LLM API Keys
# ============================================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ============================================================
# TastyTrade OAuth2 Credentials
# ============================================================
# 1. Create an OAuth app at https://my.tastytrade.com/app.html
#    - Check all scopes you need
#    - Add http://localhost:9000 as a callback URL
#    - Save the client_secret shown (only displayed once)
# 2. Go to OAuth Applications > Manage > Create Grant to get a refresh_token
#    Refresh tokens never expire.
# 3. For sandbox: create a separate account at https://developer.tastytrade.com/sandbox/
#    then repeat steps 1-2 on that account.
TASTYTRADE_CLIENT_SECRET=your_oauth_client_secret
TASTYTRADE_REFRESH_TOKEN=your_oauth_refresh_token
TASTYTRADE_ACCOUNT_NUMBER=your_account_number

# Sandbox equivalents (separate credentials from production)
TASTYTRADE_SANDBOX_CLIENT_SECRET=your_sandbox_oauth_client_secret
TASTYTRADE_SANDBOX_REFRESH_TOKEN=your_sandbox_oauth_refresh_token
TASTYTRADE_SANDBOX_ACCOUNT_NUMBER=your_sandbox_account_number


# ============================================================
# Notification Settings (optional)
# ============================================================
# Email
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_SENDER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
NOTIFICATION_RECIPIENTS=your_email@gmail.com

# Webhook (e.g. Slack, Discord, custom)
WEBHOOK_URL=

# ============================================================
# Bot Settings (override config.yaml)
# ============================================================
# Controls order execution mode. Options: dry_run | manual | sandbox | live
# dry_run  - no API calls at all, fully simulated responses
# manual   - live market data + full order generation, orders NOT submitted
# sandbox  - real orders to TastyTrade cert environment
# live     - real orders to TastyTrade production
BOT_MODE=dry_run
