# 0DTE Iron Condor Trading Bot — Environment Variables
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.

# ============================================================
# LLM API Keys
# ============================================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ============================================================
# TastyTrade Credentials
# ============================================================
TASTYTRADE_USERNAME=your_tastytrade_username
TASTYTRADE_PASSWORD=your_tastytrade_password
TASTYTRADE_ACCOUNT_NUMBER=your_account_number

# Use sandbox for paper trading (recommended for testing)
# Options: "sandbox" | "production"
TASTYTRADE_ENVIRONMENT=sandbox

# ============================================================
# Notification Settings (optional)
# ============================================================
# Email
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_SENDER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
NOTIFICATION_RECIPIENTS=your_email@gmail.com

# Webhook (e.g. Slack, Discord, custom)
WEBHOOK_URL=

# ============================================================
# Bot Settings (override config.yaml)
# ============================================================
# Controls order execution mode. Options: dry_run | manual | sandbox | live
# dry_run  - no API calls at all, fully simulated responses
# manual   - live market data + full order generation, orders NOT submitted
# sandbox  - real orders to TastyTrade cert environment
# live     - real orders to TastyTrade production
BOT_MODE=dry_run
