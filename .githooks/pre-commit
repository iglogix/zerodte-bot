#!/bin/bash
#
# Git pre-commit hook to prevent modifications to tests_locked/ directory.
# This ensures the immutable test suite remains unchanged after approval.
#
# Installation:
#   git config core.hooksPath .githooks
#
# Or copy to .git/hooks/pre-commit

# Colors for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Check for staged changes in tests_locked/
LOCKED_CHANGES=$(git diff --cached --name-only | grep "^tests_locked/")

if [ -n "$LOCKED_CHANGES" ]; then
    echo -e "${RED}ERROR: Attempting to modify immutable test files!${NC}"
    echo ""
    echo -e "${YELLOW}The following files in tests_locked/ are staged for commit:${NC}"
    echo "$LOCKED_CHANGES"
    echo ""
    echo "The tests_locked/ directory contains the immutable test suite."
    echo "These tests were approved and locked to ensure test integrity."
    echo ""
    echo "If you MUST modify these tests (with explicit approval):"
    echo "  1. Use: git commit --no-verify"
    echo "  2. Document the reason in the commit message"
    echo "  3. Get team approval before pushing"
    echo ""
    exit 1
fi

# All checks passed
exit 0
